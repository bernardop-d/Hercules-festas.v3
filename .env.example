# Copie para .env e ajuste os valores

# PostgreSQL
POSTGRES_DB=hercules
POSTGRES_USER=hercules
POSTGRES_PASSWORD=hercules

# Usada pelo app.py (gerada automaticamente pelo docker-compose)
# Para rodar localmente sem Docker, aponte para seu Postgres local:
DATABASE_URL=postgresql://hercules:hercules@localhost:5432/hercules

# Servidor
PORT=5000
HOST=0.0.0.0

{
  "name": "hercules-festas-v3",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "tsc -b && vite build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.herculesfestaas.app",
    "productName": "Hércules Festas",
    "directories": {
      "buildResources": "electron/build"
    },
    "files": [
      "electron/**/*",
      "static/**/*",
      "app.py"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "jspdf": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "dotenv": "^17.3.1",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
